# MongoDB Configuration
# Copy this to .env.local and update with your values

# For local development with MongoDB
MONGODB_URI=mongodb://localhost:27017/oak-iron-work
MONGODB_DATABASE=oak-iron-work

# For production (replace with your actual MongoDB Atlas or cloud provider values)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/oak-iron-work
# MONGODB_DATABASE=oak-iron-work

# Supabase Configuration (REQUIRED for production)
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# For local development with Supabase:
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# OpenAI API Key (for AI image generation)
OPENAI_API_KEY=your_openai_api_key_here

# Target State Configuration
# Options: Florida, Mississippi, Arizona
TARGET_STATE=Florida
# Alternative: Use NEXT_PUBLIC_TARGET_STATE for client-side access
# NEXT_PUBLIC_TARGET_STATE=Florida
